# Copy this file to the untracked root .env: `cp .env.local.example .env`
# Every process (Next.js, Bolt, Trigger.dev, the Prisma CLI) reads that one
# untracked .env file. Each parallel worktree sets its own PORT here.

# Slack
SLACK_BOT_TOKEN=xoxb-fake-local-bot-token
SLACK_APP_TOKEN=xapp-fake-local-app-token
SLACK_SIGNING_SECRET=fake-local-signing-secret
SLACK_TEAM_ID=T00000000
SLACK_WATCH_CHANNEL_IDS=C00000001,C00000002

# Google
GOOGLE_CLIENT_ID=fake-local-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-local-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI (Kilo Gateway)
AI_BASE_URL=http://localhost:4000/v1
AI_API_KEY=fake-local-ai-api-key
MODEL_FAST=fake-fast-model
MODEL_SMART=fake-smart-model

# Postgres (app + CLI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secretary
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/secretary

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_fake-local-trigger-secret
TRIGGER_PROJECT_ID=proj_fake-local-project-id

# Agent transport
AGENT_TRANSPORT=inline

# Seed identities (Phase 1 hand-seeded rows)
SEED_USER_A_SLACK_ID=U0A00000A
SEED_USER_A_EMAIL=user-a@example.com
SEED_USER_A_GOOGLE_REFRESH_TOKEN=fake-local-refresh-token-user-a
SEED_USER_B_SLACK_ID=U0B00000B
SEED_USER_B_EMAIL=user-b@example.com

# Stretch (optional — S1 graph stack)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
GRAPH_SERVICE_URL=http://localhost:8000

# Docker Compose (postgres/neo4j credentials, graph-service build context)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secretary
GRAPH_SERVICE_DIR=../graph-service

# Next.js dev server port (set per-worktree)
PORT=3000
