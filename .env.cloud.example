# Copy this file to the untracked root .env: `cp .env.cloud.example .env`
# Every process (Next.js, Bolt, Trigger.dev, the Prisma CLI) reads that one
# untracked .env file. Swapping from local to a hosted stack is an edit to
# this file and a restart only — no source file contains a hostname, port
# or credential (FND-07).

# Slack
SLACK_BOT_TOKEN=xoxb-fake-cloud-bot-token
SLACK_APP_TOKEN=xapp-fake-cloud-app-token
SLACK_SIGNING_SECRET=fake-cloud-signing-secret
SLACK_TEAM_ID=T00000000
SLACK_WATCH_CHANNEL_IDS=C00000001,C00000002

# Google
GOOGLE_CLIENT_ID=fake-cloud-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-cloud-google-client-secret
GOOGLE_REDIRECT_URI=https://app.example.com/api/auth/google/callback

# AI (Kilo Gateway)
AI_BASE_URL=https://gateway.example.com/v1
AI_API_KEY=fake-cloud-ai-api-key
MODEL_FAST=fake-fast-model
MODEL_SMART=fake-smart-model

# Postgres (hosted — e.g. Neon/Supabase pooled + unpooled connection strings)
DATABASE_URL=postgresql://user:password@fake-pooled-host.example.com:5432/secretary?sslmode=require
DIRECT_URL=postgresql://user:password@fake-direct-host.example.com:5432/secretary?sslmode=require

# Trigger.dev
TRIGGER_SECRET_KEY=tr_prod_fake-cloud-trigger-secret
TRIGGER_PROJECT_ID=proj_fake-cloud-project-id

# Agent transport
AGENT_TRANSPORT=trigger

# Seed identities (Phase 1 hand-seeded rows)
SEED_USER_A_SLACK_ID=U0A00000A
SEED_USER_A_EMAIL=user-a@example.com
SEED_USER_A_GOOGLE_REFRESH_TOKEN=fake-cloud-refresh-token-user-a
SEED_USER_B_SLACK_ID=U0B00000B
SEED_USER_B_EMAIL=user-b@example.com

# Stretch (optional — S1 graph stack, e.g. Neo4j Aura)
NEO4J_URI=neo4j+s://fake-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=fake-cloud-neo4j-password
GRAPH_SERVICE_URL=https://graph-service.example.com

# Docker Compose (postgres/neo4j credentials, graph-service build context)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fake-cloud-postgres-password
POSTGRES_DB=secretary
GRAPH_SERVICE_DIR=../graph-service

# Next.js dev server port (set per-worktree)
PORT=3000
