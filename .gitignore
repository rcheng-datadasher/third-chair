# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (D-16: one untracked root .env; example files are copy sources and stay tracked)
.env
.env.*
.env.local
.env.cloud
!.env.local.example
!.env.cloud.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# package managers other than bun (D-21: bun.lock is the one tracked lockfile)
package-lock.json
yarn.lock
pnpm-lock.yaml

# prisma (D-12: gitignored generated client, regenerated by postinstall)
prisma/generated
